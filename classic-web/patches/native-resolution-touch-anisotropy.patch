 #include "ptgfx_internal.h"
+#ifdef PT_WEB
+#include <emscripten/html5.h>
+// Enable anisotropic sampling only if WebGL explicitly exposes the extension.
+// Desktop uses up to 4x; touch GPUs use up to 2x to preserve battery/FPS.
+static GLfloat VelluM_AnisoCap()
+{
+    static GLfloat cap=-1.0f;
+    if(cap>=0.0f) return cap;
+    cap=1.0f;
+    EMSCRIPTEN_WEBGL_CONTEXT_HANDLE ctx=emscripten_webgl_get_current_context();
+    if(!ctx) return cap;
+    if(emscripten_webgl_enable_extension(ctx,"EXT_texture_filter_anisotropic")!=EMSCRIPTEN_RESULT_SUCCESS) return cap;
+    GLfloat supported=1.0f;
+    glGetFloatv(0x84FF /* GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT */, &supported);
+    int touch=EM_ASM_INT({return (navigator.maxTouchPoints || 0)>0 || matchMedia('(pointer:coarse)').matches ? 1 : 0;});
+    GLfloat wanted=touch ? 2.0f : 4.0f;
+    if(supported>=1.0f) cap=supported<wanted ? supported : wanted;
+    return cap;
+}
+#endif
