+#ifdef PT_WEB
+// Touch controls use the same SDL queue as physical input, not untrusted DOM
+// synthetic keyboard events (which Emscripten may ignore).
+extern "C" EMSCRIPTEN_KEEPALIVE int PtWeb_MobileKey(int vk, int down)
+{
+    SDL_Scancode sc=SDL_SCANCODE_UNKNOWN;
+    switch(vk) {
+        case 16: sc=SDL_SCANCODE_LSHIFT;break;
+        case 27: sc=SDL_SCANCODE_ESCAPE;break;
+        case 13: sc=SDL_SCANCODE_RETURN;break;
+        case 32: sc=SDL_SCANCODE_SPACE;break;
+        case 73: sc=SDL_SCANCODE_I;break;
+        case 83: sc=SDL_SCANCODE_S;break;
+        case 77: sc=SDL_SCANCODE_M;break;
+        case 49: sc=SDL_SCANCODE_1;break;
+        case 50: sc=SDL_SCANCODE_2;break;
+        case 51: sc=SDL_SCANCODE_3;break;
+        case 52: sc=SDL_SCANCODE_4;break;
+        case 37: sc=SDL_SCANCODE_LEFT;break;
+        case 38: sc=SDL_SCANCODE_UP;break;
+        case 39: sc=SDL_SCANCODE_RIGHT;break;
+        case 40: sc=SDL_SCANCODE_DOWN;break;
+        default: return 0;
+    }
+    SDL_Event e; SDL_zero(e);
+    e.type=down ? SDL_KEYDOWN : SDL_KEYUP;
+    e.key.keysym.scancode=sc;
+    e.key.keysym.sym=SDL_GetKeyFromScancode(sc);
+    e.key.state=down ? SDL_PRESSED : SDL_RELEASED;
+    return SDL_PushEvent(&e)>0 ? 1 : 0;
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE int PtWeb_MobileMouse(int phase, int x, int y)
+{
+    if(!s_pWindow) return 0;
+    SDL_Event e; SDL_zero(e);
+    if(phase==0){
+        e.type=SDL_MOUSEMOTION;
+        e.motion.windowID=SDL_GetWindowID(s_pWindow);
+        e.motion.x=x; e.motion.y=y;
+        e.motion.state=SDL_GetMouseState(NULL,NULL);
+    }else{
+        e.type=(phase==1 || phase==3) ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP;
+        e.button.button=(phase==3 || phase==4) ? SDL_BUTTON_RIGHT : SDL_BUTTON_LEFT;
+        e.button.windowID=SDL_GetWindowID(s_pWindow);
+        e.button.state=e.type==SDL_MOUSEBUTTONDOWN ? SDL_PRESSED : SDL_RELEASED;
+        e.button.clicks=1;
+        e.button.x=x; e.button.y=y;
+    }
+    return SDL_PushEvent(&e)>0 ? 1 : 0;
+}
+#endif
 

