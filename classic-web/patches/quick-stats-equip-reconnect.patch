 void cCHARSTATUS::RButtonDown(int x , int y)
 {
+#ifdef PT_WEB
+    // Right click an attribute's '+' to reach the highest requirement among
+    // currently equipped items. Spend only available points, one recalculation.
+    if(OpenFlag && sinChar && sinChar->StatePoint>0) {
+        int chosen=0;
+        for(int a=0;a<5;a++) {
+            if(x>=PointButton[a][0] && x<=632 &&
+               y>=PointButton[a][1] && y<=PointButton[a][3]) {chosen=a+1;break;}
+        }
+        if(chosen) {
+            int required=0;
+            for(int i=0;i<INVENTORY_MAX_POS && i<10;i++) {
+                int slot=sInven[i].ItemIndex;
+                if(slot<1 || slot>INVENTORY_MAXITEM)continue;
+                sITEM *eq=&cInvenTory.InvenItem[slot-1];
+                if(!eq->Flag || !eq->ItemPosition || !eq->sItemInfo.ItemHeader.dwChkSum)continue;
+                int r=chosen==1 ? eq->sItemInfo.Strength :
+                      chosen==2 ? eq->sItemInfo.Spirit :
+                      chosen==3 ? eq->sItemInfo.Talent :
+                      chosen==4 ? eq->sItemInfo.Dexterity : eq->sItemInfo.Health;
+                if(r>required)required=r;
+            }
+            int *value=chosen==1 ? &sinChar->Strength :
+                        chosen==2 ? &sinChar->Spirit :
+                        chosen==3 ? &sinChar->Talent :
+                        chosen==4 ? &sinChar->Dexterity : &sinChar->Health;
+            int missing=required-*value;
+            if(missing>sinChar->StatePoint)missing=sinChar->StatePoint;
+            if(missing>0) {
+                static const int kinds[5]={POINT_STRENGTH,POINT_SPIRIT,POINT_TALENT,POINT_DEXTERITY,POINT_HEALTH};
+                CheckCharForm();
+                *value+=missing;
+                sinChar->StatePoint-=missing;
+                // Preserve the original 128-entry undo history as the normal '+' does.
+                for(int j=0;j<missing;j++){
+                    for(int q=0;q<127;q++)TempStatePoint[q]=TempStatePoint[q+1];
+                    TempStatePoint[127]=kinds[chosen-1];
+                }
+                ReformCharForm();
+                cInvenTory.SetItemToChar();
+                cInvenTory.CheckDamage();
+            }
+            return;
+        }
+    }
+#endif
+
