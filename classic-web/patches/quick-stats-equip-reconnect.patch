 void cINVENTORY::RButtonDown(int x , int y)
 {
+#ifdef PT_WEB
+    // One-click equip for a valid item from the backpack, without dropping
+    // anything or replacing occupied equipment slots without free space.
+    if(OpenFlag && !MouseItem.Flag && !sinItemPickUpDelayFlag &&
+       !cWareHouse.OpenFlag && !cTrade.OpenFlag && !cCraftItem.OpenFlag &&
+       !cShop.OpenFlag && !cMixtureReset.OpenFlag && !cMyShop.OpenFlag &&
+       !cCharShop.OpenFlag && !SmeltingItem.OpenFlag &&
+       !ManufactureItem.m_OpenFlag && !SpecialItemShowFlag &&
+       !SetDelayFlag && !sSinWarpGate.ShowFlag && lpCurPlayer &&
+       lpCurPlayer->MotionInfo &&
+       lpCurPlayer->MotionInfo->State!=CHRMOTION_STATE_ATTACK &&
+       lpCurPlayer->MotionInfo->State!=CHRMOTION_STATE_SKILL) {
+        for(int n=0;n<INVENTORY_MAXITEM;n++) {
+            sITEM *entry=&InvenItem[n];
+            if(!entry->Flag || entry->ItemPosition || !entry->lpItem ||
+               entry->Class==ITEM_CLASS_POTION || entry->sItemInfo.NotUseFlag ||
+               MyShopItemIndex[n] || entry->sItemInfo.SpecialItemFlag[1]==ITEM_KIND_SPECIAL)continue;
+            if(x<=entry->x || x>=entry->x+entry->w ||
+               y<=entry->y || y>=entry->y+entry->h)continue;
+            int pos=-1;
+            for(int i=0;i<10;i++){
+                if(!(entry->Class & sInven[i].Position) || sInven[i].ItemIndex)continue;
+                if(entry->Class==ITEM_CLASS_WEAPON_TWO &&
+                   (sInven[0].ItemIndex || sInven[1].ItemIndex))continue;
+                pos=i;break;
+            }
+            if(pos<0)break; // No valid vacant slot: leave the item untouched.
+            sITEM moving=*entry;
+            moving.ItemPosition=pos+1;
+            moving.SetX=sInven[pos].Rect.left+
+                (sInven[pos].Rect.right-sInven[pos].Rect.left-moving.w)/2;
+            moving.SetY=sInven[pos].Rect.top+
+                (sInven[pos].Rect.bottom-sInven[pos].Rect.top-moving.h)/2;
+            // The same item is being moved, not gained: do not duplicate.
+            entry->Flag=0;
+            if(!LastSetInvenItem(&moving,1)){
+                entry->Flag=1;
+                ReFormInvenItem();
+            }else{
+                SelectInvenItemIndex=0;
+            }
+            return;
+        }
+    }
+#endif
+
 	
